rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lessons: every device needs to read them (children and teachers alike).
    // Only a signed-in teacher can create, edit or delete a lesson.
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Tighter option: only specific teacher emails may write.
      // Replace the addresses below and swap the line above for this one
      // if you want to restrict publishing to named teachers only.
      // allow write: if request.auth != null &&
      //   request.auth.token.email in ['teacher1@yourchurch.org', 'teacher2@yourchurch.org'];
    }

    // Children's profiles and progress: open by design, because children
    // do not sign in on this app — they just pick their name on a shared
    // tablet. That means anyone who has the app's link can read or edit
    // any child's record. This is a reasonable trade-off for a small,
    // trusted Sunday School setting, but it means this link should never
    // be posted somewhere public.
    match /profiles/{profileId} {
      allow read, write: if true;
    }
    match /progress/{profileId} {
      allow read, write: if true;
    }
  }
}
